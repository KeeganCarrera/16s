library(vegan)
library(tidyverse)

make_rarefaction_df <- function(ps_obj) {
  otu <- as.data.frame(t(otu_table(ps_obj)))
  rare <- rarecurve(otu, step = 100, label = FALSE)
  
  # Convert rarecurve output to tidy data frame
  rare_df <- map_df(rare, ~{
    tibble(
      SampleID = names(rare)[[which(rare == .x)]],
      Reads = attr(.x, "Subsample"),
      Richness = .x
    )
  })
  
  # Add metadata
  meta <- sample_data(ps_obj) %>% as.data.frame() %>% rownames_to_column("SampleID")
  left_join(rare_df, meta, by = "SampleID")
}

