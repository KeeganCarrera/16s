plot_aldex_effect_groups <- function(df, g1, g2, title) {
  
  df2 <- df %>%
    mutate(
      enriched = ifelse(effect > 0, g1, g2),
      sig_star = ifelse(we.eBH < 0.05, "*", "")
    )
  
  print(
    ggplot(df2, aes(
      x = reorder(Genus, effect),
      y = effect,
      fill = enriched
    )) +
      geom_bar(stat = "identity") +
      geom_text(
        aes(label = sig_star),
        hjust = ifelse(df2$effect > 0, -0.6, 1.6),   # star position
        size = 6,
        color = "black"
      ) +
      coord_flip() +
      scale_fill_manual(values = group_colors, drop = FALSE) +
      scale_y_continuous(
        expand = expansion(mult = c(0.25, 0.25))     # <-- MUCH more padding both sides
      ) +
      labs(
        title = title,
        x = "Genus",
        y = "Effect Size (ALDEx2)"
      ) +
      theme_bw(base_size = 14) +
      theme(
        plot.title = element_text(hjust = 0.5, size = 16),
        legend.title = element_blank(),
        axis.text.y = element_text(size = 12),
        axis.text.x = element_text(size = 12)
      )
  )
}
