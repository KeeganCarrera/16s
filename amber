# Function to run stats for one metric
run_alpha_stats <- function(df, metric, timepoint_label) {
  
  # Kruskal–Wallis
  kw <- kruskal.test(df[[metric]] ~ df$group)
  
  # Dunn test
  dunn <- dunnTest(df[[metric]] ~ df$group, method = "bh")
  
  # Save results
  kw_df <- data.frame(
    Metric = metric,
    Timepoint = timepoint_label,
    Statistic = kw$statistic,
    P_value = kw$p.value
  )
  
  dunn_df <- dunn$res
  
  write.csv(kw_df,
            file = file.path(outdir, paste0("KW_", metric, "_", timepoint_label, ".csv")),
            row.names = FALSE)
  
  write.csv(dunn_df,
            file = file.path(outdir, paste0("Dunn_", metric, "_", timepoint_label, ".csv")),
            row.names = FALSE)
}

# Run for all metrics at both timepoints
