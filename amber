summarize_metric <- function(df, metric) {
  df %>%
    group_by(timepoint, group) %>%
    summarise(
      n = n(),
      mean = mean(.data[[metric]], na.rm = TRUE),
      sd = sd(.data[[metric]], na.rm = TRUE),
      median = median(.data[[metric]], na.rm = TRUE),
      IQR = IQR(.data[[metric]], na.rm = TRUE),
      min = min(.data[[metric]], na.rm = TRUE),
      max = max(.data[[metric]], na.rm = TRUE)
    ) %>%
    arrange(timepoint, group)
}

